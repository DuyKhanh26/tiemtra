rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chủ quán: đúng tài khoản Google đã xác minh email
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'duykhanh2605.pq@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Nhân viên: có tài liệu staff/<email viết thường> do chủ quán tạo
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()));
    }

    // Thông tin quán + thực đơn: ai cũng xem được, chỉ chủ quán được sửa
    match /shop/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Danh sách nhân viên: chỉ chủ quán quản lý; nhân viên chỉ đọc được tài liệu của chính mình
    match /staff/{id} {
      allow read: if isOwner()
        || (request.auth != null && request.auth.token.email.lower() == id);
      allow write: if isOwner();
    }

    // Bàn đang mở: khách chỉ kiểm tra được từng bàn (không liệt kê được); nhân viên/chủ quán mở & đóng bàn
    match /openTables/{t} {
      allow get: if true;
      allow list, create, update, delete: if isOwner() || isStaff();
    }

    // Yêu cầu mở bàn do khách gửi, nhân viên/chủ quán duyệt
    match /tableRequests/{rid} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.table is string
        && request.resource.data.table.size() > 0
        && request.resource.data.table.size() <= 12
        && request.resource.data.keys().hasOnly(['table', 'status', 'createdAt', 'name'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
      allow get: if true;   // mã yêu cầu ngẫu nhiên, khách chỉ xem được yêu cầu của chính mình
      allow list: if isOwner() || isStaff();
      allow update: if (isOwner() || isStaff())
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt']);
      allow delete: if isOwner() || isStaff();
    }

    // Đơn hàng
    match /orders/{id} {
      // Không cho khách tự đặt đơn "đã thanh toán"; số bàn là chữ ngắn
      function cleanExtras() {
        return (!('billStatus' in request.resource.data) || request.resource.data.billStatus == 'open')
          && (!('table' in request.resource.data) || (request.resource.data.table is string && request.resource.data.table.size() <= 12))
          // Khách chỉ được gọi món vào bàn đã được nhân viên/chủ quán MỞ (chống nhập số bàn ảo)
          && (!('table' in request.resource.data) || isStaff()
              || exists(/databases/$(database)/documents/openTables/$(request.resource.data.table)));
      }
      // Nhân viên: đổi đơn từ 'new' sang 'done'
      function staffDone() {
        return resource.data.status == 'new'
          && request.resource.data.status == 'done'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'doneBy']);
      }
      // Nhân viên: tính tiền bàn (billStatus từ 'open' sang 'paid')
      function staffPay() {
        return resource.data.billStatus == 'open'
          && request.resource.data.billStatus == 'paid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billStatus', 'paidAt', 'paidBy', 'payMethod', 'billCode']);
      }

      // Nhân viên: xác nhận khách đã thanh toán đơn mang đi/giao (chỉ bật lên, không tắt được)
      function staffPaid() {
        return request.resource.data.orderPaid == true
          && (!('orderPaid' in resource.data) || resource.data.orderPaid == false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderPaid', 'orderPaidAt', 'orderPaidBy']);
      }

      // Nhân viên: chuyển/gộp bàn (chỉ đổi số bàn của đơn chưa tính tiền, có ghi vết)
      function staffMove() {
        return resource.data.billStatus == 'open'
          && request.resource.data.billStatus == 'open'
          && request.resource.data.table is string
          && request.resource.data.table.size() > 0
          && request.resource.data.table.size() <= 12
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['table', 'movedFrom', 'movedAt', 'movedBy']);
      }

      // Khách (không đăng nhập) và nhân viên được tạo đơn mới ở trạng thái 'new'
      allow create: if isOwner() || (
        request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && cleanExtras()
      );
      // Chủ quán và nhân viên được xem đơn
      allow read: if isOwner() || isStaff();
      // Nhân viên CHỈ được: xong đơn, tính tiền bàn, chuyển bàn, hoặc xác nhận khách đã thanh toán (không sửa món/giá, không huỷ, không mở lại)
      allow update: if isOwner() || (isStaff() && (staffDone() || staffPay() || staffMove() || staffPaid()));
      // Chỉ chủ quán được xoá đơn
      allow delete: if isOwner();
    }
  }
}
